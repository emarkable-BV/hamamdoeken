{% unless template == 'index'
  or template == 'cart'
  or template == 'list-collections'
%}
  {% liquid
    assign justify = justify | default: 'start'
    case justify
      when 'left'
        assign justify = 'start'
      when 'right'
        assign justify = 'end'
    endcase
  %}
  {% capture separator_icon %}
  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4.5 2.25L8.25 6L4.5 9.75" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  {% endcapture %}
  <div class="{{ container }}">
    <nav
      class="breadcrumbs flex justify-{{ justify }}"
      role="navigation"
      aria-label="breadcrumbs"
    >
      <a href="/" title="Home">{{ 'general.breadcrumbs.home' | t }}</a>
      {% if template contains 'page' %}
        <span aria-hidden="true" class="breadcrumbs--sep">
          {{- separator_icon -}}
        </span>
        <span>{{ page.title }}</span>
      {% elsif template contains 'product' %}
        {% liquid
          assign primary_collection = product.metafields.breadcrumb.primary_collection
        %}
        {% if collection.url != blank %}
          <span aria-hidden="true" class="breadcrumbs--sep">
            {{- separator_icon -}}
          </span>
          {% if primary_collection != blank %}
            {{
              primary_collection.value.title
              | link_to: primary_collection.value.url
            }}
          {% else %}
            {{ collection.title | link_to: collection.url }}
          {% endif %}
        {% else %}
          {% assign current_collection = product.collections | first %}
          <span aria-hidden="true" class="breadcrumbs--sep">
            {{- separator_icon -}}
          </span>
          {% if primary_collection != blank %}
            <a href="{{ primary_collection.value.url }}">
              {{- primary_collection.value.title -}}
            </a>
          {% else %}
            {% if current_collection %}
              <a href="{{ current_collection.url }}">
                {{- current_collection.title -}}
              </a>
            {% endif %}
          {% endif %}
        {% endif %}
        {% if current_collection or primary_collection %}
          <span
            aria-hidden="true"
            class="breadcrumbs--sep breadcrumbs--sep-last"
          >
            {{- separator_icon -}}
          </span>
        {% endif %}
        <span class="breadcrumbs--last">{{ product.title }}</span>
      {% elsif template contains 'collection' and collection.handle %}
        {% if collection.handle != 'all' %}
          <span aria-hidden="true" class="breadcrumbs--sep">
            {{- separator_icon -}}
          </span>
          <a href="{{ routes.all_products_collection_url }}">
            {{- 'general.breadcrumbs.collections' | t -}}
          </a>
        {% endif %}
        <span aria-hidden="true" class="breadcrumbs--sep">
          {{- separator_icon -}}
        </span>
        {% if current_tags %}
          {% capture url %}{{ routes.collections_url }}/{{ collection.handle }}{% endcapture %}
          {{ collection.title | link_to: url }}
          <span aria-hidden="true" class="breadcrumbs--sep">
            {{- separator_icon -}}
          </span>
          <span class="breadcrumbs--last">
            {{- current_tags | join: ' + ' -}}
          </span>
        {% else %}
          <span class="breadcrumbs--last">{{ collection.title }}</span>
        {% endif %}
      {% elsif template == 'blog' %}
        <span aria-hidden="true" class="breadcrumbs--sep">
          {{- separator_icon -}}
        </span>
        {% if current_tags %}
          {{ blog.title | link_to: blog.url }}
          <span aria-hidden="true" class="breadcrumbs--sep">
            {{- separator_icon -}}
          </span>
          <span class="breadcrumbs--last">
            {{- current_tags | join: ' + ' -}}
          </span>
        {% else %}
          <span>{{ blog.title }}</span>
        {% endif %}
      {% elsif template == 'article' %}
        <span aria-hidden="true" class="breadcrumbs--sep">
          {{- separator_icon -}}
        </span>
        {{ blog.title | link_to: blog.url }}
        <span aria-hidden="true" class="breadcrumbs--sep">
          {{- separator_icon -}}
        </span>
        <span class="breadcrumbs--last">{{ article.title }}</span>
      {% else %}
        <span aria-hidden="true" class="breadcrumbs--sep">
          {{- separator_icon -}}
        </span>
        <span class="breadcrumbs--last">{{ page_title }}</span>
      {% endif %}
    </nav>
  </div>

  {%- comment %} CUSTOM (Hamamdoeken): BreadcrumbList die hetzelfde pad volgt als de zichtbare kruimels hierboven {% endcomment -%}
  {%- unless template contains 'search' or template contains 'customers' or template contains '404' -%}
    {%- liquid
      assign bc_names = 'general.breadcrumbs.home' | t
      assign bc_urls = request.origin | append: routes.root_url
      assign bc_sep = '~~~'

      if template contains 'page'
        assign bc_names = bc_names | append: bc_sep | append: page.title
        assign bc_urls = bc_urls | append: bc_sep | append: request.origin | append: page.url
      elsif template contains 'product'
        assign bc_collection = nil
        if primary_collection != blank
          assign bc_collection = primary_collection.value
        elsif collection.url != blank
          assign bc_collection = collection
        else
          assign bc_collection = product.collections | first
        endif
        if bc_collection
          assign bc_names = bc_names | append: bc_sep | append: bc_collection.title
          assign bc_urls = bc_urls | append: bc_sep | append: request.origin | append: bc_collection.url
        endif
        assign bc_names = bc_names | append: bc_sep | append: product.title
        assign bc_urls = bc_urls | append: bc_sep | append: request.origin | append: product.url
      elsif template contains 'collection' and collection.handle
        if collection.handle != 'all'
          assign bc_all_label = 'general.breadcrumbs.collections' | t
          assign bc_names = bc_names | append: bc_sep | append: bc_all_label
          assign bc_urls = bc_urls | append: bc_sep | append: request.origin | append: routes.all_products_collection_url
        endif
        assign bc_names = bc_names | append: bc_sep | append: collection.title
        assign bc_urls = bc_urls | append: bc_sep | append: request.origin | append: collection.url
        if current_tags
          assign bc_tags = current_tags | join: ' + '
          assign bc_names = bc_names | append: bc_sep | append: bc_tags
          assign bc_urls = bc_urls | append: bc_sep | append: canonical_url
        endif
      elsif template == 'blog'
        assign bc_names = bc_names | append: bc_sep | append: blog.title
        assign bc_urls = bc_urls | append: bc_sep | append: request.origin | append: blog.url
        if current_tags
          assign bc_tags = current_tags | join: ' + '
          assign bc_names = bc_names | append: bc_sep | append: bc_tags
          assign bc_urls = bc_urls | append: bc_sep | append: canonical_url
        endif
      elsif template == 'article'
        assign bc_names = bc_names | append: bc_sep | append: blog.title | append: bc_sep | append: article.title
        assign bc_urls = bc_urls | append: bc_sep | append: request.origin | append: blog.url | append: bc_sep | append: request.origin | append: article.url
      else
        assign bc_names = bc_names | append: bc_sep | append: page_title
        assign bc_urls = bc_urls | append: bc_sep | append: canonical_url
      endif

      assign bc_names = bc_names | split: bc_sep
      assign bc_urls = bc_urls | split: bc_sep
    -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          {%- for bc_name in bc_names -%}
            {%- assign bc_index = forloop.index0 -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "name": {{ bc_name | strip_html | strip | json }},
              "item": {{ bc_urls[bc_index] | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endunless -%}
{% endunless %}
