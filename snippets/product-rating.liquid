{%- if product.metafields.reviews.rating.value != blank -%}
  {%- liquid
    assign rating_decimal = 0
    assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
    if decimal >= 0.3 and decimal <= 0.7
      assign rating_decimal = 0.5
    elsif decimal > 0.7
      assign rating_decimal = 1
    endif

    assign star_size = block.settings.star_size | default: 10
    assign star_svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>'
  -%}
  <div
    class="f-product-rating"
    style="--star-size: {{ star_size | divided_by: 10 }}; --star-color: {{ block.settings.star_color | default: '#feb806' }}"
  >
    <div
      class="rating"
      role="img"
      aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
    >
      <span
        aria-hidden="true"
        class="rating-star"
        style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
      >
        <span class="rating-star__track">{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}</span>
        <span class="rating-star__fill"
          ><span class="rating-star__fill-inner"
            >{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}{{ star_svg }}</span
          ></span
        >
      </span>
    </div>
    <p class="rating-text text-subtext">
      <span aria-hidden="true">
        {{- product.metafields.reviews.rating.value }} /
        {{ product.metafields.reviews.rating.value.scale_max -}}
      </span>
    </p>
    <p class="rating-count text-subtext">
      <span aria-hidden="true"
        >({{ product.metafields.reviews.rating_count }})</span
      >
      <span class="visually-hidden">
        {{- product.metafields.reviews.rating_count }}
        {{ 'accessibility.total_reviews' | t -}}
      </span>
    </p>
  </div>
{%- endif -%}
